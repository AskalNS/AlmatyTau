# =============================================================================
#  ТОО «Almaty Tau Management» — переменные окружения
#
#  Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.
#  Секреты сгенерировать: openssl rand -base64 48
# =============================================================================

# --- Общее ------------------------------------------------------------------
NODE_ENV=production
TZ=Asia/Almaty
# Swagger-документация API на /api/docs (требование п. II ТЗ). false — отключить.
ENABLE_SWAGGER=true

# Публичные адреса. Меняются на боевые домены при переносе на хостинг.
PUBLIC_WEB_URL=https://atm.kz
PUBLIC_ADMIN_URL=https://admin.atm.kz
PUBLIC_API_URL=https://api.atm.kz

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=atm
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=atm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://atm:CHANGE_ME_postgres@postgres:5432/atm?schema=public&connection_limit=20

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_URL=redis://:CHANGE_ME_redis@redis:6379

# --- Хранилище файлов (MinIO, S3-совместимое) -------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=atm-media
S3_ACCESS_KEY=CHANGE_ME_minio_access
S3_SECRET_KEY=CHANGE_ME_minio_secret
# Домен, с которого браузер забирает медиа. Отдельный от основного —
# так вредоносный файл не исполнится в контексте сайта (п. X.III ТЗ).
S3_PUBLIC_URL=https://media.atm.kz

# --- JWT --------------------------------------------------------------------
# Два РАЗНЫХ секрета. Одинаковые позволяют подменить refresh на access.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_48_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_48_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Безопасность (п. X ТЗ) -------------------------------------------------
# Имя в приложении-аутентификаторе (Google Authenticator и т.п.)
TOTP_ISSUER=ATM Admin
# Блокировка после N неудачных попыток входа
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Минимальная длина пароля
PASSWORD_MIN_LENGTH=12
# Через запятую, без пробелов. Строгий allow-list, звёздочка запрещена.
CORS_ORIGINS=https://atm.kz,https://admin.atm.kz

# --- Почта (форма обратной связи, приглашения пользователей) ----------------
SMTP_HOST=smtp.example.kz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@atm.kz
SMTP_PASSWORD=CHANGE_ME_smtp
MAIL_FROM="ATM <noreply@atm.kz>"
# Получатель писем из формы обратной связи
FEEDBACK_TO=info@atm.kz

# --- Первичный администратор (создаётся сидом при первом запуске) -----------
SEED_ADMIN_EMAIL=admin@atm.kz
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Внешние сервисы --------------------------------------------------------
# Веб-аналитика (п. IX ТЗ). Пусто — счётчик не подключается.
ANALYTICS_ID=
# Карты (п. VI ТЗ)
MAPS_PROVIDER=2gis
MAPS_API_KEY=

# --- Фронтенды --------------------------------------------------------------
# URL API для сборки Next.js и Vite (подставляются на этапе build)
NEXT_PUBLIC_API_URL=https://api.atm.kz
NEXT_PUBLIC_SITE_URL=https://atm.kz
VITE_API_URL=https://api.atm.kz

# Секрет для вебхука ревалидации ISR: админка дёргает его при публикации
REVALIDATE_SECRET=CHANGE_ME_revalidate_secret

# --- Резервное копирование (п. XI ТЗ) ---------------------------------------
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 3 * * *
