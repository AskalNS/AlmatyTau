# Разработка ведётся на Windows, развёртывание — Docker на Linux.
# Без этого файла CRLF попадает в образы и shell-скрипты падают
# с невнятным "no such file or directory" на строке shebang.

* text=auto eol=lf

# Явно текстовые — всегда LF
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf
*.svg      text eol=lf
*.sql      text eol=lf
*.prisma   text eol=lf
*.env      text eol=lf
.env.*     text eol=lf

# Исполняемые в контейнере — LF обязателен
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.conf          text eol=lf
entrypoint*     text eol=lf

# PowerShell остаётся с CRLF — он запускается на Windows-сервере
*.ps1      text eol=crlf

# Бинарные — не трогать
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.avif     binary
*.gif      binary
*.ico      binary
*.pdf      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
*.mp4      binary
*.webm     binary
*.zip      binary
