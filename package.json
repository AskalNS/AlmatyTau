{
  "name": "atm",
  "version": "1.0.0",
  "private": true,
  "description": "Официальный веб-сайт ТОО «Almaty Tau Management»",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "_comment_overrides": "file-type>=17 — ESM-only, ломает require() в CJS-бэкенде. Пиним CJS-версию во всём дереве.",
  "pnpm": {
    "overrides": {
      "file-type": "16.5.4"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "build": "pnpm --filter @atm/contracts build && pnpm --parallel --filter \"./apps/*\" build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @atm/backend prisma:generate",
    "db:migrate": "pnpm --filter @atm/backend prisma:migrate",
    "db:seed": "pnpm --filter @atm/backend prisma:seed",
    "db:seed:content": "pnpm --filter @atm/backend content:seed",
    "db:studio": "pnpm --filter @atm/backend prisma:studio",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
